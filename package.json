{
  "name": "azmoon-paper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build -w @exam/frontend",
    "start": "npm run start -w @exam/backend",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @exam/backend",
    "test:pdf": "node scripts/pdf-fixtures.js",
    "format": "prettier --write apps packages tests scripts *.js *.json",
    "dev:frontend": "npm run dev -w @exam/frontend",
    "dev:backend": "npm run dev -w @exam/backend",
    "start:frontend": "npm run start -w @exam/frontend",
    "android:sync": "node scripts/android.mjs sync",
    "android:debug": "node scripts/android.mjs debug",
    "android:release": "node scripts/android.mjs release",
    "test:offline": "npm run build && playwright test -c playwright.pwa.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "light-my-request": "^6.8.0",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.5.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.0",
    "mongodb": "^7.8.0",
    "sharp": "^0.34.0",
    "vue": "^3.5.0",
    "pinia": "^3.0.0",
    "@vue/server-renderer": "^3.5.0",
    "express": "^5.1.0",
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
