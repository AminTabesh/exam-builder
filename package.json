    "@vue/server-renderer": "^3.5.0",
    "@vueuse/core": "^13.0.0",
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^6.0.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "katex": "^0.16.22",
    "moment-jalaali": "^0.9.6",
    "mongodb": "^7.8.0",
    "multer": "^2.0.0",
    "nodemailer": "^7.0.0",
