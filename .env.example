MONGODB_URI=mongodb://127.0.0.1:27017/exam?replicaSet=rs0
MONGODB_DB=exam
SESSION_SECRET=replace-with-at-least-32-random-bytes
OTP_SECRET=replace-with-an-independent-random-secret
APP_URL=http://localhost:5173
PORT=3001
FRONTEND_PORT=5173
API_INTERNAL_URL=http://127.0.0.1:3001
ASSET_DIR=./data/assets
# Development only: both phone and email OTPs print in the backend terminal.
OTP_DELIVERY=console
# Set OTP_DELIVERY=providers and configure SMTP to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Exam <exam@example.com>
# CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Server-only AI configuration. Empty key disables generation.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_DAILY_CALL_LIMIT=100

# Android public build configuration (no secrets in VITE_ variables).
VITE_API_URL=https://azmounbarg.ir
VITE_SUPPORT_EMAIL=
# Server-only Bazaar API and signed receipt verification.
BAZAAR_PACKAGE_NAME=ir.azmounbarg.app
BAZAAR_API_TOKEN=
BAZAAR_RSA_PUBLIC_KEY=
BAZAAR_TOKEN_SECRET=
BAZAAR_SKU_STANDARD=
BAZAAR_SKU_PROFESSIONAL=
BAZAAR_SKU_PROFESSIONAL_AI=
# Set signing variables only in your shell/CI secret store, never commit a keystore.
